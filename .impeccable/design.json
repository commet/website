  "narrative": {
    "northStar": "The Editorial Work Record",
    "overview": "A warm, restrained editorial world gives the work room to be examined. Book-serif names establish identity; Korean and English reading text stays in a quiet sans serif. Hairline divisions and broad margins organize the page without enclosing every thought in a card.\n\nReal project imagery carries its own visual detail and color. The surrounding interface remains calm enough for captions, scope, and context to stay legible. A dark green field and a pale green field provide changes in reading pace within the same flat material language.",
    "keyCharacteristics": [
      "Warm paper, charcoal ink, and a restrained rust accent.",
      "Self-hosted serif identity paired with bilingual sans-serif reading text.",
      "Square evidence panels, hairline divisions, and open column layouts.",
      "Visible content, explicit links, and keyboard-readable control states."
    ],
    "rules": [
      {
        "name": "The Quiet Frame Rule",
        "body": "Keep the surrounding site palette restrained; colors inside genuine project evidence belong to that evidence and need not match the site accent.",
        "section": "colors"
      },
      {
        "name": "The Reading Language Rule",
        "body": "Preserve word boundaries in Korean and explicit whitespace in English when headings reflow. Headings balance their lines; paragraphs can wrap long strings to prevent overflow.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Continue the page through spacing, rules, and tonal fields; keep evidence panels and editorial content flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** pair real evidence with readable captions, context, and a named full-image link.",
      "**Do** use serif identity and sans-serif bilingual reading text for their established roles.",
      "**Do** retain visible keyboard focus, selected-tab underlines, and reduced-motion behavior.",
      "**Do** let desktop spreads collapse into a single reading column while preserving whitespace between words.",
      "**Do** keep the two contact paths equal in hierarchy and visual weight."
    ],
    "donts": [
      "**Don't** add floating card shells, shadows, or rounded screenshot panels to the flat editorial world.",
      "**Don't** make screenshot text carry information that must be read in surrounding prose.",
      "**Don't** promote one project's illustration colors or bespoke display size into the shared token system.",
      "**Don't** invent an input, chip, modal, or button family that the build does not implement."
    ]
  }
}
